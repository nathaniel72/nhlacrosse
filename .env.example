# Postgres connection string. For local dev: `npx prisma dev --name lacrosse -d`
# and paste the URL it prints. For production, use your hosted Postgres
# (e.g. a free Neon.tech database).
DATABASE_URL=""

# The public URL of the site (used in email links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used one-time by `npm run create-admin` to create/update your admin login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Where new-submission / restring-request notifications are sent.
ADMIN_NOTIFICATION_EMAIL=""

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM=""

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Shopify Storefront API (merch page) — leave blank until you have a store.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
